page {
  min-height: 100vh;
  background: #f4f7fb;
}

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 64px 24px 32px;
  background: linear-gradient(180deg, #eef4ff 0, #f4f7fb 280px, #f4f7fb 100%);
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32px;
}

.logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68px;
  height: 68px;
  margin-bottom: 18px;
  color: #ffffff;
  font-size: 21px;
  font-weight: 800;
  background: #1769e0;
  border-radius: 8px;
  box-shadow: 0 10px 24px rgba(23, 105, 224, 0.22);
}

.title {
  margin-bottom: 8px;
  color: #172033;
  font-size: 22px;
  font-weight: 700;
  text-align: center;
}

.subtitle {
  color: #7b8493;
  font-size: 13px;
}

.form-area {
  padding: 24px 20px;
  background-color: #ffffff;
  border: 1px solid #e4e8ee;
  border-radius: 8px;
  box-shadow: 0 8px 28px rgba(23, 32, 51, 0.08);
}

.input-group { margin-bottom: 18px; }
.label {
  display: block;
  margin-bottom: 8px;
  color: #566174;
  font-size: 13px;
  font-weight: 600;
}
.input {
  width: 100%;
  height: 48px;
  padding: 0 14px;
  color: #172033;
  font-size: 15px;
  background-color: #f7f9fb;
  border: 1px solid #e1e6ed;
  border-radius: 6px;
}
.input:focus {
  background-color: #ffffff;
  border-color: #1769e0;
}
.login-btn {
  width: 100%;
  height: 48px;
  margin-top: 8px;
  color: #ffffff;
  font-size: 16px;
  font-weight: 600;
  line-height: 48px;
  background: #1769e0;
  border-radius: 6px;
  box-shadow: 0 6px 14px rgba(23, 105, 224, 0.2);
}
.login-btn:active { background: #1259c1; }
.login-btn[loading] { opacity: 0.72; }

.demo-info {
  margin-top: 18px;
  padding: 16px 18px;
  background: #ffffff;
  border: 1px solid #e4e8ee;
  border-radius: 8px;
}
.demo-title {
  display: block;
  margin-bottom: 10px;
  color: #566174;
  font-size: 13px;
  font-weight: 600;
}
.demo-list {
  display: flex;
  flex-wrap: wrap;
}
.demo-item {
  width: 50%;
  padding: 4px 0;
  color: #8b95a5;
  font-size: 12px;
  line-height: 1.55;
}
