page { background-color: #f4f6f8; }
.container { padding: 16px 16px 100px; }

.filter-panel {
  margin-bottom: 14px;
  padding: 14px;
  background: #ffffff;
  border: 1px solid #e4e8ee;
  border-radius: 8px;
  box-shadow: 0 4px 16px rgba(23, 32, 51, 0.05);
}
.tab-header {
  display: flex;
  margin-bottom: 14px;
  padding: 4px;
  background: #e9edf2;
  border-radius: 8px;
}
.tab {
  flex: 1;
  height: 38px;
  color: #667085;
  font-size: 14px;
  font-weight: 500;
  line-height: 38px;
  text-align: center;
  border-radius: 6px;
}
.tab.active {
  color: #172033;
  font-weight: 600;
  background: #ffffff;
  box-shadow: 0 2px 8px rgba(23, 32, 51, 0.08);
}
.model-filter {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
}
.filter-label { display: block; color: #172033; font-size: 13px; font-weight: 600; }
.filter-hint { display: block; margin-top: 3px; color: #8b95a5; font-size: 11px; }
.model-filter picker { width: 58%; }
.model-picker {
  position: relative;
  width: 100%;
  height: 40px;
  padding: 0 30px 0 12px;
  overflow: hidden;
  color: #1769e0;
  font-size: 12px;
  font-weight: 600;
  line-height: 40px;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
  background: #eef5ff;
  border: 1px solid #cfe0f8;
  border-radius: 6px;
}
.model-picker::after {
  position: absolute;
  top: 14px;
  right: 12px;
  width: 7px;
  height: 7px;
  border-right: 1px solid #1769e0;
  border-bottom: 1px solid #1769e0;
  transform: rotate(45deg);
  content: '';
}

.summary-grid { display: flex; margin: -4px -4px 10px; }
.summary-item {
  position: relative;
  flex: 1;
  min-width: 0;
  margin: 4px;
  padding: 14px 11px;
  overflow: hidden;
  background: #ffffff;
  border: 1px solid #e4e8ee;
  border-radius: 8px;
}
.summary-item::before {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 3px;
  content: '';
}
.summary-item.primary::before { background: #1769e0; }
.summary-item.success::before { background: #15966f; }
.summary-item.danger::before { background: #d94f4f; }
.summary-label { display: block; color: #8b95a5; font-size: 11px; }
.summary-value {
  display: block;
  margin: 7px 0 5px;
  overflow: hidden;
  color: #172033;
  font-size: 23px;
  font-weight: 700;
  line-height: 1;
  text-overflow: ellipsis;
}
.summary-note {
  display: block;
  overflow: hidden;
  color: #8b95a5;
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chart-section {
  margin-bottom: 14px;
  padding: 20px 18px;
  background: #ffffff;
  border: 1px solid #e4e8ee;
  border-radius: 8px;
  box-shadow: 0 4px 16px rgba(23, 32, 51, 0.05);
}
.section-head { display: flex; align-items: flex-start; justify-content: space-between; }
.sec-title { color: #172033; font-size: 15px; font-weight: 700; line-height: 1.45; }
.chart-desc { margin-top: 5px; margin-bottom: 20px; color: #8b95a5; font-size: 12px; line-height: 1.5; }
.total-badge {
  flex-shrink: 0;
  margin-left: 10px;
  padding: 5px 8px;
  color: #1769e0;
  font-size: 11px;
  font-weight: 600;
  background: #eef5ff;
  border-radius: 4px;
}

.trend-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 188px;
  padding-top: 16px;
  background-image: linear-gradient(to bottom, #edf0f4 1px, transparent 1px);
  background-size: 100% 45px;
  border-bottom: 1px solid #dfe4ea;
}
.trend-col { display: flex; flex: 1; flex-direction: column; align-items: center; min-width: 0; }
.col-num {
  max-width: 100%;
  margin-bottom: 6px;
  overflow: hidden;
  color: #667085;
  font-size: 10px;
  font-weight: 600;
  text-overflow: ellipsis;
}
.col-bar { width: 24px; background: #1769e0; border-radius: 4px 4px 0 0; transition: height 0.6s ease; }
.col-bar.empty-bar { background: #dfe4ea; }
.col-date {
  max-width: 100%;
  margin-top: 8px;
  overflow: hidden;
  color: #667085;
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.model-row { margin-bottom: 18px; }
.model-row:last-child { margin-bottom: 0; }
.model-meta { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 8px; }
.model-meta > view { flex: 1; min-width: 0; }
.model-name { display: block; overflow: hidden; color: #172033; font-size: 12px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.model-category { display: block; margin-top: 3px; color: #8b95a5; font-size: 10px; }
.model-qty { flex-shrink: 0; margin-left: 10px; color: #566174; font-size: 11px; }
.model-track { height: 8px; overflow: hidden; background: #edf0f4; border-radius: 4px; }
.model-fill { height: 100%; background: #15966f; border-radius: 4px; }

.bar-item { margin-bottom: 18px; }
.bar-item:last-child { margin-bottom: 0; }
.bar-label { margin-bottom: 8px; color: #566174; font-size: 12px; font-weight: 500; }
.bar-track-wrap { display: flex; align-items: center; }
.bar-track { flex: 1; height: 10px; overflow: hidden; background: #edf0f4; border-radius: 4px; }
.bar-fill { height: 100%; border-radius: 4px; transition: width 0.6s ease; }
.bar-num { flex-shrink: 0; min-width: 42px; color: #566174; font-size: 11px; font-weight: 600; text-align: right; }
.bg-red { background: #d94f4f; }
.bg-orange { background: #d98b12; }
.bg-blue { background: #1769e0; }
.bg-green { background: #15966f; }
.chart-empty { padding: 24px 0 12px; color: #8b95a5; font-size: 12px; text-align: center; }
