page { background-color: #f4f6f8; }
.container { padding: 16px 16px 100px; }

.search-box {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  margin-bottom: 14px;
  padding: 8px;
  background: #ffffff;
  border: 1px solid #e4e8ee;
  border-radius: 8px;
  box-shadow: 0 4px 16px rgba(23, 32, 51, 0.05);
}
.input {
  display: block;
  width: 100%;
  height: 52px;
  padding: 0 12px;
  color: #172033;
  font-size: 13px;
  background: #f7f9fb;
  border: 1px solid #e1e6ed;
  border-radius: 6px;
}
.input:focus { background: #ffffff; border-color: #1769e0; }
.search-actions {
  display: flex;
  width: 100%;
  margin-top: 8px;
}
.scan-btn,
.search-btn {
  flex: 1;
  width: auto;
  min-width: 0;
  height: 44px;
  margin: 0;
  padding: 0;
  font-size: 13px;
  font-weight: 600;
  line-height: 44px;
  border-radius: 6px;
}
.scan-btn {
  margin-right: 8px;
  color: #1769e0;
  background: #eef5ff;
  border: 1px solid #cfe0f8;
}
.search-btn {
  color: #ffffff;
  background: #1769e0;
}
.search-btn:active { background: #1259c1; }

.mode-switch {
  display: flex;
  margin-bottom: 14px;
  padding: 4px;
  background: #e9edf2;
  border-radius: 8px;
}
.mode-btn {
  flex: 1;
  height: 40px;
  margin: 0;
  padding: 0;
  color: #667085;
  font-size: 14px;
  font-weight: 500;
  line-height: 40px;
  background: transparent;
  border-radius: 6px;
}
.mode-btn.active {
  color: #172033;
  font-weight: 600;
  background: #ffffff;
  box-shadow: 0 2px 8px rgba(23, 32, 51, 0.08);
}

.timeline {
  padding: 22px 18px;
  background: #ffffff;
  border: 1px solid #e4e8ee;
  border-radius: 8px;
  box-shadow: 0 4px 16px rgba(23, 32, 51, 0.05);
}
.timeline-item {
  position: relative;
  display: flex;
  min-height: 94px;
}
.timeline-item:last-child { min-height: auto; }
.timeline-left {
  display: flex;
  flex-shrink: 0;
  flex-direction: column;
  align-items: center;
  width: 22px;
  margin-right: 14px;
}
.dot {
  z-index: 2;
  width: 10px;
  height: 10px;
  margin-top: 3px;
  background: #b7bfcb;
  border: 2px solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 0 0 2px #dfe4ea;
}
.dot-active { background: #15966f; box-shadow: 0 0 0 3px rgba(21, 150, 111, 0.16); }
.line { flex: 1; width: 1px; margin-top: 6px; background: #dfe4ea; }
.timeline-content {
  position: relative;
  flex: 1;
  min-width: 0;
  padding: 0 24px 20px 0;
}
.time { display: block; margin-bottom: 5px; color: #8b95a5; font-size: 11px; }
.title {
  display: block;
  margin-bottom: 7px;
  color: #172033;
  font-size: 15px;
  font-weight: 700;
}
.desc { display: flex; flex-direction: column; }
.desc .operator { margin-bottom: 3px; color: #566174; font-size: 12px; }
.desc .result { color: #1769e0; font-size: 12px; font-weight: 600; }
.arrow {
  position: absolute;
  top: 24px;
  right: 0;
  color: #a8b0bd;
  font-size: 20px;
}

.groups { display: flex; flex-direction: column; }
.group-card {
  margin-bottom: 14px;
  overflow: hidden;
  background: #ffffff;
  border: 1px solid #e4e8ee;
  border-radius: 8px;
  box-shadow: 0 4px 16px rgba(23, 32, 51, 0.05);
}
.group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15px 18px;
  background: #f9fafb;
  border-bottom: 1px solid #e8ebf0;
}
.group-title { color: #172033; font-size: 15px; font-weight: 700; }
.group-count {
  padding: 3px 7px;
  color: #667085;
  font-size: 11px;
  background: #edf0f4;
  border-radius: 4px;
}
.group-list { padding: 0 18px; }
.group-item {
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 14px 22px 14px 0;
  border-bottom: 1px solid #edf0f4;
}
.group-item:last-child { border-bottom: 0; }
.group-item:active { background: #f9fafb; }
.item-header { display: flex; align-items: center; justify-content: space-between; }
.item-id { color: #172033; font-size: 14px; font-weight: 600; }
.item-arrow { position: absolute; top: 50%; right: 0; color: #a8b0bd; font-size: 18px; transform: translateY(-50%); }
.item-desc { margin-top: 5px; color: #8b95a5; font-size: 12px; }
.item-result { margin-top: 4px; color: #1769e0; font-size: 12px; font-weight: 600; }

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 58px 20px;
  text-align: center;
}
.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56px;
  height: 56px;
  margin-bottom: 14px;
  color: #8b95a5;
  font-size: 14px;
  font-weight: 700;
  background: #edf0f4;
  border: 1px solid #dfe4ea;
  border-radius: 8px;
}
.empty-title { display: block; margin-bottom: 7px; color: #172033; font-size: 16px; font-weight: 700; }
.empty-desc { display: block; margin-bottom: 22px; color: #8b95a5; font-size: 13px; line-height: 1.6; }
.empty-btn {
  width: 124px;
  height: 44px;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 14px;
  font-weight: 600;
  line-height: 44px;
  background: #1769e0;
  border-radius: 6px;
}

.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  background: rgba(15, 23, 42, 0.48);
  animation: fadeIn 0.2s ease;
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
.modal-container {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1001;
  animation: slideUp 0.25s ease;
}
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
.modal-content {
  display: flex;
  flex-direction: column;
  max-height: 82vh;
  overflow: hidden;
  background: #ffffff;
  border-radius: 8px 8px 0 0;
}
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 20px;
  border-bottom: 1px solid #e8ebf0;
}
.modal-title { color: #172033; font-size: 17px; font-weight: 700; }
.modal-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  color: #667085;
  font-size: 17px;
  background: #f1f3f6;
  border-radius: 50%;
}
.modal-body { flex: 1; padding: 8px 20px; overflow-y: auto; }
.detail-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 12px 0;
  border-bottom: 1px solid #edf0f4;
}
.detail-row:last-child { border-bottom: 0; }
.detail-label { flex-shrink: 0; width: 80px; color: #8b95a5; font-size: 13px; }
.detail-value { flex: 1; color: #172033; font-size: 13px; font-weight: 500; text-align: right; word-break: break-all; }
.modal-footer { padding: 14px 20px 26px; border-top: 1px solid #e8ebf0; }
.modal-btn {
  width: 100%;
  height: 46px;
  color: #ffffff;
  font-size: 15px;
  font-weight: 600;
  line-height: 46px;
  background: #1769e0;
  border-radius: 6px;
}
