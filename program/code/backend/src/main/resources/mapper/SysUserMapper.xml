    <select id="getById" resultMap="SysUserMap">
        select `id`, `employee_no`, `password_hash`, `name`, `role_code`, `role_name`, `department`, `position`, `phone`, `skill_level`, `status`, `create_time`, `update_time` from `sys_user` where `id` = #{id}
