            </if>
            <if test="phone != null and phone != ''">
                `phone`,
            </if>
            <if test="skillLevel != null and skillLevel != ''">
                `skill_level`,
            </if>
            <if test="status != null">
                `status`,
            </if>
            <if test="createTime != null">
                `create_time`,
            </if>
            <if test="updateTime != null">
                `update_time`,
            </if>
        </trim>
        <trim prefix=" values(" suffix=")" suffixOverrides=",">
            <if test="employeeNo != null and employeeNo != ''">
                #{employeeNo},
