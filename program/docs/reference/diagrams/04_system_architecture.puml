@startuml Keyboard_MES_System_Architecture_Current
top to bottom direction

skinparam defaultFontName Microsoft YaHei
skinparam backgroundColor #FFFFFF
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor #334155
skinparam component {
  BorderColor #334155
  BackgroundColor #FFFFFF
  RoundCorner 8
}
skinparam package {
  BorderColor #94A3B8
  RoundCorner 10
}

title Keyboard Assembly MES - 当前系统架构图

package "客户端" as ClientLayer #EEF2FF {
  component "Vue Web Console\nVue 3 + Vue Router + Vite\nhttp://localhost:5173" as Web
  component "WeChat Mini Program\nWXML / WXSS / JS" as Mini
}

package "HTTP API" as ApiLayer #E0F2FE {
  component "AuthController\n/api/auth" as AuthController
  component "Resource Controllers\n用户、产品、物料、BOM、工艺、工单、任务" as ResourceControllers
  component "Workflow Controllers\n生成任务 / 报工 / 检验 / 返修 / 复检" as WorkflowControllers
  component "Trace & Report Controllers\n/api/trace /api/report" as ReportControllers
}

package "安全边界" as SecurityLayer #FEF3C7 {
  component "AuthInterceptor\n登录态和角色动作校验" as Interceptor
  component "AuthSessionService\nCookie / Authorization -> Redis Session" as SessionService
  component "MesShiroRealm\n账号密码认证" as Realm
}

package "业务服务" as ServiceLayer #ECFDF5 {
  component "Master Data Services\n产品、物料、BOM、工艺" as MasterServices
  component "Production Services\n工单、任务、报工联动" as ProductionServices
  component "Quality Services\n检验、返修、复检" as QualityServices
  component "Trace / Report Services\nSN 追溯、统计分析" as TraceReportServices
}

package "数据访问" as DataAccessLayer #FDF2F8 {
  component "MyBatis Mapper Interfaces\nrepository/*.java" as MapperInterfaces
  component "Mapper XML\nresources/mapper/*.xml" as MapperXml
}

package "基础设施" as Infrastructure #F8FAFC {
  database "MySQL keyboard_mes\n业务数据" as MySQL
  component "Redis\n登录状态" as Redis
  component "api-contract.json\n接口契约" as Contract
  component "SQL Scripts\nschema / mock / demo / reset" as SqlScripts
}

ClientLayer -down-> ApiLayer : /api 请求
ApiLayer -down-> SecurityLayer : 认证与授权
ApiLayer -down-> ServiceLayer : 业务编排
ServiceLayer -down-> DataAccessLayer : Mapper 调用
DataAccessLayer -down-> MySQL : SQL 执行
SecurityLayer -down-> Redis : 会话读写
SqlScripts -left-> MySQL : 初始化与演示数据
Contract -up-> ClientLayer : 前后端契约

note right of ClientLayer
  当前前端是 Vite 项目。
  vendor/vue.global.js 属于本地兜底依赖，
  不是主要架构入口。
end note

@enduml
